    "@webcontainer/api": "^1.6.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "groq-sdk": "^1.6.0",
    "isomorphic-git": "^1.42.2",
    "lucide-react": "^1.48.0",
    "monaco-editor": "0.55.1",
