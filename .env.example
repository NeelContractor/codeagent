# Annotated template for local development.
#
#   cp .env.example .env
#
# `.env` is read by BOTH Next.js and `docker compose`, which is why the
# Postgres values live here: compose interpolates them into the container, and
# Next.js needs DATABASE_URL to reach it. Keep POSTGRES_PORT and the port in
# DATABASE_URL in sync. Never commit `.env`.

# --- PostgreSQL (service "postgres", image postgres:16) ---
# Host port published on your machine; the container always listens on 5432.
# If 5432 is already taken locally, change this and the DATABASE_URL port to
# match.
POSTGRES_PORT=5432
POSTGRES_USER=codeagent
POSTGRES_PASSWORD=codeagent_dev
POSTGRES_DB=codeagent

# Connection string used by the app and by drizzle-kit.
DATABASE_URL=postgresql://codeagent:codeagent_dev@localhost:5432/codeagent

# --- Project snapshots ---
# Directory where project snapshots are written. Relative paths resolve from the
# project root; an absolute path suits a container mount. Gitignored (/data).
SNAPSHOT_DIR=./data/snapshots

# --- Auth.js / NextAuth v5 ---
# Auth.js v5 reads AUTH_* (NEXTAUTH_* still work as legacy fallbacks).
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
# Requests the `public_repo` scope: cloning and pushing public repositories
# only, never private ones. The in-editor Git panel stays hidden until both
# values are set.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Email + password sign-in for the seeded dev user. Must be exactly "true" to
# enable. Leave false in production.
AUTH_ENABLE_CREDENTIALS=true

# --- Seed user (bun run db:seed) ---
SEED_NAME=Dev User
SEED_EMAIL=dev@codeagent.test
SEED_PASSWORD=devpassword

# --- LLM provider (Groq) ---
# The chat panel returns "LLM_API_KEY is not configured on the server" when
# this is empty. Get a key at https://console.groq.com/keys
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
